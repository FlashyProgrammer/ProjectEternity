  m_Script: {fileID: 11500000, guid: 7e787bb2f794a6a4695134e4583867ae, type: 3}
  m_Name: Ophilia Jones Initial
  m_EditorClassIdentifier: Assembly-CSharp::Character
  charName: Eternity
  characterSprite: {fileID: 8013740796401983728, guid: bc45d0c45810e4f4c8ec60be231b7e55, type: 3}
  lines:
  - "Hello\u2026?"
  - Can anyone hear me?
  - "Oh good. There is someone\u2026"
  - Please, help me. My name is Ophilia.
  - "I\u2019m confused\u2026 and I\u2019m frightened."
  - "I remember closing my eyes\u2026 after waiting for someone who never came."
  - Then I woke up here.
  - "It looks a little like my father\u2019s study\u2026 but it isn\u2019t right.
    It\u2019s too big\u2026 too empty in places it shouldn\u2019t be. Like something
    important has been taken out and never returned."
  - "And these vines\u2026 they weren\u2019t here before. They keep growing in places
    I try not to think about. Like they\u2019re coming from\u2026 somewhere inside
    this place."
  - "I don\u2019t understand what\u2019s happening."
  - "Do you know where I am\u2026? Can you help me?"
